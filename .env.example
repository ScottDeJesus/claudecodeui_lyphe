# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# Uncomment to reach Descent (account switching, usage, memory intake) somewhere other than the default
# DESCENT_URL=http://127.0.0.1:7878

# The command Source Control's "Push my changes" button sends, as the whole prompt of the
# conversation it starts. It must begin with /git: the push guard authorises a push only for a
# session whose prompt does. Point it at a read-only command to exercise the button safely.
# A read-only command is still not a read-only SESSION: the guard's test is /git followed by a
# word boundary, and a hyphen is one, so a value like /git-rehearsal mints the same push grant
# inside a conversation this button starts with permissions bypassed. Keep such a value in place
# only as long as the run that needs it.
# VITE_GIT_DELEGATION_COMMAND=/git

# Where CloudCLI's chat embeds a DocSpace block from (ArchPulse, port 8005). Unset = this page's own
# hostname on :8005, which is right on the LAN and over Tailscale. Set it to reach ArchPulse through
# another host. It must be an ABSOLUTE http:// or https:// URL — anything else (a bare host like
# eis1:8005, or a javascript:/data: scheme) is ignored, the default is used, and a console warning
# says so. It must also be a DIFFERENT origin from this app's: the embed frame carries
# allow-same-origin so the block can edit itself, and a frame on this app's origin could read its
# login token.
# VITE_DOCSPACE_EMBED_ORIGIN=http://100.103.222.79:8005

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000



# DeepSeek — the plan runner's builder, its fix-pass and Athena ride deepseek-flash while
# Settings → Agents → Claude → "Use DeepSeek Flash for build souls" is on. Read by the plan runner
# (`~/.claude/hooks/plan_runner/deepseek.py`) straight from this file at each soul spawn so a runner
# restarted from cron still finds it, and by the CloudCLI server three ways: systemd's
# `EnvironmentFile=` into the process environment at service start, `server/load-env.ts` into
# `process.env` at each boot, and `server/modules/deepseek/deepseek-key.ts` per request for the
# account panel's balance line (docs/deepseek-balance.md). The server also writes the switch file
# the runner polls. Leave empty to keep every soul on Claude and the balance line reading unknown.
#
# ONE LIVE LINE PER KEY. The readers of this file disagree about a repeat: `load-env.ts` keeps the
# FIRST assignment and copies the value verbatim, quotes and all, while the two that read the file
# directly — `deepseek-key.ts` and the plan runner's — keep the LAST and take the quotes off, as
# systemd's `EnvironmentFile=` does. So a second live line hands them different values, and that
# shows up as a key that works for builds and is refused on the balance line. WRITE VALUES BARE for
# the same reason: `load-env.ts` puts quotes into `process.env` as part of the value, and only a
# reader that unquotes at the point of use gets the value back (the balance module does; nothing
# else here promises to). A line already in this file is only re-read when a process BOOTS — an edit
# under a running server reaches the balance route, which reads the file per request, and reaches
# nothing else until the unit or its child restarts. And this file holds the box's only credential:
# never print it to a terminal, and rotate at the vendor rather than delete a log if it escapes.
DEEPSEEK_API_KEY=
